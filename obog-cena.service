[Unit]
Description=OBOG cena (asistencia)
After=network.target

[Service]
WorkingDirectory=/home/dcarrero/Sites/private/universidad/obog-cena
ExecStart=/home/dcarrero/.nvm/versions/node/v26.13.1/bin/node --disable-warning=ExperimentalWarning --env-file=.env server.js
Restart=on-failure
User=dcarrero
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dcarrero/Sites/private/universidad/obog-cena/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
